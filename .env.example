# Variables de entorno — copia a .env.local y rellena.
# .env.local está en .gitignore; este archivo sí se versiona a propósito.

# Ruta del archivo SQLite. El directorio padre se crea solo si no existe.
DATABASE_URL=./data/finanbolsa.db

# --- Autenticación (obligatorias desde que existe src/proxy.ts) ---

# Contraseña de acceso. Sin ella la app sirve /login pero rechaza todo.
AUTH_PASSWORD=

# Secreto para firmar la cookie de sesión. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Cambiarlo invalida todas las sesiones activas (útil para revocar acceso).
AUTH_SECRET=

# Ponlo en "true" SOLO si sirves la app por HTTPS. En una IP de LAN por http
# plano, una cookie Secure es descartada por el navegador y el login es
# imposible.
FINANBOLSA_HTTPS=false
