# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local sqlite database
/data/*.db
/data/*.db-journal
/data/*.db-wal
/data/*.db-shm
# nightly backups (see npm run db:backup)
/data/backups/
# scratch dir used by db:verify-backup to restore a copy without touching the
# live database
/data/restore-test/
# The whole directory, not just the known names: the 50k-row benchmark database
# lives here too, and so does any scratch database created while testing a
# fresh install. `data/` is the one directory the container mounts as a volume,
# so anything left in it belongs to the host, not to the repo.
/data/*

# typescript
*.tsbuildinfo
next-env.d.ts
